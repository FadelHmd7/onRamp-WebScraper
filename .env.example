# Copy to .env and change what you need. Never commit .env.
# Every value below is also the default in docker-compose.yml, so the stack
# starts without a .env file.

APP_ENV=development
LOG_LEVEL=info

# Descriptive User-Agent with a real contact address. Required before
# crawling real sites.
USER_AGENT=onRamp-WebScraper/0.1 (+https://github.com/FadelHmd7/onRamp-WebScraper; contact: you@example.com)

# API logins, seeded by the migrate service on every start (changing a
# password here and running `docker compose up` updates it). The defaults
# below work locally; with APP_ENV other than "development" the API refuses
# them. JWT_SECRET: at least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-only-jwt-secret-not-for-production-use
JWT_TTL_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-dev-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer-dev-password

# Credentials for the bundled services. Change them outside local development.
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=scraper
RABBITMQ_USER=scraper
RABBITMQ_PASSWORD=scraper

# Host ports.
UI_PORT=9070
API_PORT=9060
RABBITMQ_UI_PORT=15672
TESTSITE_PORT=9050

# Delay the test site adds to catalog and item pages, like a real network.
TESTSITE_LATENCY_MS=50

# Crawl limits. The per-domain rate is shared by every worker.
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=50
REQUESTS_PER_SECOND=1
MAX_FETCH_ATTEMPTS=5
# Retry backoff: attempt n waits a random time up to RETRY_BASE_DELAY * 2^(n-1)
# seconds, at most RETRY_MAX_DELAY. A server's Retry-After is always respected.
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=300
# A job running longer than this many seconds is stopped and retried.
TASK_SOFT_TIME_LIMIT=120
# A killed worker leaves the "active workers" count within HEARTBEAT_TTL seconds.
HEARTBEAT_TTL=15
HEARTBEAT_INTERVAL=5

# Autoscaler (bonus): docker compose --profile autoscale up -d
# Workers = backlog / AUTOSCALE_JOBS_PER_WORKER, between MIN and MAX. Up at
# once; down one worker per AUTOSCALE_COOLDOWN seconds of low backlog.
AUTOSCALE_MIN=1
AUTOSCALE_MAX=8
AUTOSCALE_JOBS_PER_WORKER=25
AUTOSCALE_COOLDOWN=30
AUTOSCALE_INTERVAL=5
