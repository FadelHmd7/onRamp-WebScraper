# Copy to .env and change what you need. Never commit .env.
# Every value below is also the default in docker-compose.yml, so the stack
# starts without a .env file.

APP_ENV=development
LOG_LEVEL=info

# Descriptive User-Agent with a real contact address. Required before
# crawling real sites.
USER_AGENT=onRamp-WebScraper/0.1 (+https://github.com/FadelHmd7/onRamp-WebScraper; contact: you@example.com)

# Credentials for the bundled services. Change them outside local development.
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=scraper
RABBITMQ_USER=scraper
RABBITMQ_PASSWORD=scraper

# Host ports.
UI_PORT=9070
API_PORT=9060
RABBITMQ_UI_PORT=15672
TESTSITE_PORT=9050

# Delay the test site adds to catalog and item pages, like a real network.
TESTSITE_LATENCY_MS=50

# Crawl limits. The per-domain rate is shared by every worker.
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=50
REQUESTS_PER_SECOND=1
MAX_FETCH_ATTEMPTS=5
# Retry backoff: attempt n waits a random time up to RETRY_BASE_DELAY * 2^(n-1)
# seconds, at most RETRY_MAX_DELAY. A server's Retry-After is always respected.
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=300
# A job running longer than this many seconds is stopped and retried.
TASK_SOFT_TIME_LIMIT=120
