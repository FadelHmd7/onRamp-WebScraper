# Copy to .env and fill in. Do not commit .env.

APP_ENV=development
LOG_LEVEL=info

# Descriptive User-Agent. Replace the contact address before crawling.
USER_AGENT=onRamp-WebScraper/0.1 (contact: you@example.com)

# Shared services. Hostnames match the Compose service names added in E2.
DATABASE_URL=postgresql://scraper:scraper@postgres:5432/scraper
REDIS_URL=redis://redis:6379/0

# Crawl limits. Per-domain rate is shared by every worker.
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=50
REQUESTS_PER_SECOND=1
MAX_FETCH_ATTEMPTS=5
